<sql-parser-test-cases>
    <reset-parameter sql-case-id="reset_session_authorization_postgresql" configuration-parameter="session_authorization" />
    <reset-parameter sql-case-id="reset_time_zone_postgresql" configuration-parameter="timezone" />
    <reset-parameter sql-case-id="reset_custom_parameter_postgresql" configuration-parameter="custom.foo" />
    <reset-parameter sql-case-id="reset_all_postgresql" configuration-parameter="ALL" />
    <explain sql-case-id="explain_merge_format_json_postgresql">
        <merge>
            <target>
                <simple-table name="foo" start-index="33" stop-index="35" />
            </target>
            <source>
                <simple-table name="bar" start-index="43" stop-index="45" />
            </source>
            <expr>
                <binary-operation-expression start-index="50" stop-index="64">
                    <left>
                        <column name="id" start-index="50" stop-index="55">
                            <owner name="foo" start-index="50" stop-index="52" />
                        </column>
                    </left>
                    <operator>=</operator>
                    <right>
                        <column name="id" start-index="59" stop-index="64">
                            <owner name="bar" start-index="59" stop-index="61" />
                        </column>
                    </right>
                </binary-operation-expression>
            </expr>
            <merge-items />
        </merge>
        <table name="foo" start-index="33" stop-index="35" />
        <table name="bar" start-index="43" stop-index="45" />
        <table name="foo" start-index="50" stop-index="52" />
        <table name="bar" start-index="59" stop-index="61" />
    </explain>
    <explain sql-case-id="explain_create_table_as_postgresql">
        <create-table>
            <table name="foo" start-index="21" stop-index="23" />
            <select>
                <from>
                    <simple-table name="bar" start-index="43" stop-index="45" />
                </from>
                <projections start-index="35" stop-index="36">
                    <column-projection name="id" start-index="35" stop-index="36" />
                </projections>
            </select>
        </create-table>
    </explain>
    <common sql-case-id="analyze_only_postgresql" />
    <common sql-case-id="vacuum_only_postgresql" />
    <explain sql-case-id="explain_create_table_as_column_names_postgresql">
        <create-table>
            <table name="foo" start-index="21" stop-index="23" />
            <column name="id" start-index="25" stop-index="26" />
            <select>
                <from>
                    <simple-table name="bar" start-index="47" stop-index="49" />
                </from>
                <projections start-index="39" stop-index="40">
                    <column-projection name="id" start-index="39" stop-index="40" />
                </projections>
            </select>
        </create-table>
    </explain>
    <explain sql-case-id="explain_create_table_as_execute_postgresql" parameters="1">
        <create-table parameters="1">
            <table name="foo" start-index="21" stop-index="23" />
            <column name="id" start-index="25" stop-index="26" />
        </create-table>
    </explain>
</sql-parser-test-cases>
