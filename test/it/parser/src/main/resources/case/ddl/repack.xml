<sql-parser-test-cases>
    <repack sql-case-id="repack_all_pg" using-index="false" />
    <repack sql-case-id="repack_using_index_pg" using-index="true">
        <table name="t" start-index="7" stop-index="7" />
    </repack>
    <repack sql-case-id="repack_named_index_pg" using-index="true">
        <table name="t" start-index="7" stop-index="7" />
        <index name="idx" start-index="21" stop-index="23" />
    </repack>
    <repack sql-case-id="repack_analyze_columns_pg" using-index="false">
        <table name="t" start-index="17" stop-index="17" />
        <column name="a" start-index="20" stop-index="20" />
        <options start-index="7" stop-index="15">
            <property key="analyze" value="true" start-index="8" stop-index="14" />
        </options>
    </repack>
    <repack sql-case-id="repack_global_index_pg" using-index="true" />
    <repack sql-case-id="repack_quoted_pg" using-index="true">
        <table name="Table1" start-index="7" stop-index="14" start-delimiter="&quot;" end-delimiter="&quot;" />
        <index name="Index1" start-index="28" stop-index="35" start-delimiter="&quot;" end-delimiter="&quot;" />
    </repack>
</sql-parser-test-cases>
