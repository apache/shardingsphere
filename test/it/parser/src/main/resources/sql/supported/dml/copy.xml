    <sql-case id="copy_numeric_header_pg" value="COPY foo_table FROM STDIN (HEADER 2)" db-types="PostgreSQL" />
    <sql-case id="copy_positive_header_pg" value="COPY foo_table FROM STDIN (HEADER +2)" db-types="PostgreSQL" />
    <sql-case id="copy_negative_zero_header_pg" value="COPY foo_table FROM STDIN (HEADER -0)" db-types="PostgreSQL" />
</sql-cases>
